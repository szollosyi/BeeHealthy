<Window x:Class="BeeHealthyLoginClient.Ablakok.receptManagement.NewReceptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BeeHealthyLoginClient.Ablakok.receptManagement"
        mc:Ignorable="d"
        Title="NewReceptWindow" Height="450" Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label>Taj szám:</Label>
            <ComboBox x:Name="cbxTajSzam" SelectionChanged="cbxTajSzam_SelectionChanged" IsEditable="True"/>
            <Label>Páciens neve:</Label>
            <ComboBox x:Name="cbxPaciens" IsEnabled="False"/>
            <Label>Gyógyszer neve:</Label>
            <ComboBox x:Name="cbxGyogyszer" IsEditable="True"/>
            <Label>Orvos neve:</Label>
            <ComboBox x:Name="cbxOrvos" IsEditable="True"/>
            <Label>Kezelési időpont:</Label>
            <TextBox x:Name="tbxKezelesiIdopont"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <Label>Kezelés kezdete:</Label>
                    <DatePicker x:Name="dpKezdet"/>
                </StackPanel>
                <Label Content="-" VerticalAlignment="Bottom"/>
                <StackPanel>
                    <Label>Kezelés vége:</Label>
                    <DatePicker x:Name="dpVeg"/>
                </StackPanel>
            </StackPanel>
            <Label>Adagolás:</Label>
            <TextBox x:Name="tbxAdagolas"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Mentés" Margin="5" Padding="10" Click="Mentes"/>
            <Button Content="Mésge" Margin="5" Padding="10" Click="Megse"/>
        </StackPanel>
    </Grid>
</Window>
